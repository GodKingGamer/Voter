rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // ===== App "Những người quá rảnh" (giữ nguyên) =====
    match /data/users/{uid}/{doc=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn();
      allow delete: if signedIn();
    }
    match /groups/{gid} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      function isOwner() { return get(/databases/$(database)/documents/groups/$(gid)).data.ownerId == request.auth.uid; }

      match /members/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && (request.auth.uid == uid || isOwner());
      }
      match /events/{eid} {
        allow read, write: if signedIn();
      }
    }

    // ===== App "Bình chọn nhanh" =====
    match /polls/{pid} {
      function pollOwnerNow() { return get(/databases/$(database)/documents/polls/$(pid)).data.ownerId == request.auth.uid; }
      function pollOwnerAfter() { return getAfter(/databases/$(database)/documents/polls/$(pid)).data.ownerId == request.auth.uid; }

      // Biết link (mã poll) thì đọc được; chỉ chủ poll liệt kê được poll của mình
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2 && request.resource.data.options.size() <= 12
        && request.resource.data.maxPick is int
        && request.resource.data.maxPick >= 1 && request.resource.data.maxPick <= 12;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /imgs/{oid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && pollOwnerAfter()
          && request.resource.data.data is string && request.resource.data.data.size() < 300000;
        allow delete: if signedIn() && pollOwnerNow();
      }

      // Phiếu: id = tên đã chuẩn hóa; chỉ tạo mới (không sửa), mỗi thiết bị (uid ẩn danh) một phiếu
      match /votes/{key} {
        allow read: if signedIn();
        allow create: if signedIn()
          && key.matches('^[a-z0-9-]{2,80}$')
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
          && request.resource.data.choices is list
          && request.resource.data.choices.size() >= 1
          && request.resource.data.choices.size() <= get(/databases/$(database)/documents/polls/$(pid)).data.maxPick
          && get(/databases/$(database)/documents/polls/$(pid)).data.closed == false
          && !exists(/databases/$(database)/documents/polls/$(pid)/devices/$(request.auth.uid));
        allow delete: if signedIn() && pollOwnerNow();
      }
      match /devices/{uid} {
        allow create: if signedIn() && request.auth.uid == uid;
        allow read: if signedIn() && (request.auth.uid == uid || pollOwnerNow());
        allow delete: if signedIn() && pollOwnerNow();
      }
    }
  }
}
